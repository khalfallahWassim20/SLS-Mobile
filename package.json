{
  "name": "sls-mobile",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "tsx --test packages/domain/test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/api/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "mobile": "npm run start --workspace @sls/mobile",
    "api": "npm run dev --workspace @sls/api",
    "admin": "npm run dev --workspace @sls/admin",
    "migrate": "npm run migrate --workspace @sls/api",
    "test:journal-db": "tsx --test apps/api/test/*postgres.test.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
